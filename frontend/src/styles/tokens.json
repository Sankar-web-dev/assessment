{
  "color": {
    "primary-700": "#3730A3",
    "primary-600": "#4338CA",
    "primary-100": "#E0E7FF",
    "primary-50": "#EEF2FF",
    "accent-600": "#C2410C",
    "accent-50": "#FFF1E8",
    "success-700": "#15803D",
    "success-50": "#ECFDF3",
    "warning-700": "#B45309",
    "warning-50": "#FFF7E6",
    "danger-700": "#B91C1C",
    "danger-50": "#FEF2F2",
    "gray-900": "#111827",
    "gray-700": "#374151",
    "gray-600": "#4B5563",
    "gray-500": "#6B7280",
    "gray-300": "#D1D5DB",
    "gray-200": "#E5E7EB",
    "gray-100": "#F3F4F6",
    "gray-50": "#F9FAFB",
    "white": "#FFFFFF",
    "focus-ring": "#A5B4FC"
  },
  "typography": {
    "fontFamily": { "heading": "Poppins", "body": "Inter" },
    "display": { "font": "Poppins", "weight": 700, "size": 40, "lineHeight": 48 },
    "h1": { "font": "Poppins", "weight": 700, "size": 32, "lineHeight": 40 },
    "h2": { "font": "Poppins", "weight": 600, "size": 24, "lineHeight": 32 },
    "h3": { "font": "Poppins", "weight": 600, "size": 20, "lineHeight": 28 },
    "price-lg": { "font": "Inter", "weight": 700, "size": 28, "lineHeight": 36 },
    "body-lg": { "font": "Inter", "weight": 400, "size": 18, "lineHeight": 28 },
    "body": { "font": "Inter", "weight": 400, "size": 16, "lineHeight": 24 },
    "body-sm": { "font": "Inter", "weight": 400, "size": 14, "lineHeight": 20 },
    "label": { "font": "Inter", "weight": 600, "size": 14, "lineHeight": 20 },
    "button": { "font": "Inter", "weight": 600, "size": 14, "lineHeight": 20 },
    "caption": { "font": "Inter", "weight": 600, "size": 12, "lineHeight": 16 }
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "xl": 24, "pill": 999 },
  "elevation": {
    "shadow-sm": "0 1px 2px rgba(17,24,39,.06)",
    "shadow-md": "0 6px 16px rgba(17,24,39,.08)",
    "shadow-lg": "0 16px 40px rgba(17,24,39,.12)"
  },
  "layout": {
    "containerMaxWidth": 1200,
    "pagePadding": 24,
    "pagePaddingMobile": 16,
    "headerHeight": 72,
    "headerHeightMobile": 64,
    "gridGap": 24,
    "gridGapMobile": 12,
    "productGridColumns": [4, 3, 2],
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "controlHeights": { "sm": 36, "md": 44, "lg": 52 },
    "iconSize": 20,
    "iconStroke": 2,
    "transition": "150ms ease-out"
  }
}
